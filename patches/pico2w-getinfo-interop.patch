 #define CRED_STORE_STATE_SIZE 16
 #define DEV_STATE_SIZE (2 * CRED_STORE_STATE_SIZE)
 
+static CborError encode_available_transports(CborEncoder *parent) {
+    bool usb = false, smart_card = false;
+#ifdef ENABLE_EMULATION
+    usb = true;
+#else
+#ifdef USB_ITF_HID
+    usb = ITF_HID != ITF_INVALID;
+#endif
+#ifdef USB_ITF_CCID
+    smart_card = ITF_CCID != ITF_INVALID || ITF_WCID != ITF_INVALID;
+#endif
+#endif
+    CborEncoder array;
+    CborError error = cbor_encoder_create_array(parent, &array, (usb ? 1 : 0) + (smart_card ? 1 : 0));
+    if (error == CborNoError && usb) {
+        error = cbor_encode_text_stringz(&array, "usb");
+    }
+    if (error == CborNoError && smart_card) {
+        error = cbor_encode_text_stringz(&array, "smart-card");
+    }
+    if (error != CborNoError) {
+        return error;
+    }
+    return cbor_encoder_close_container(parent, &array);
+}
